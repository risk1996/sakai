# Supplied by xtask from devenv's resolved Rust toolchain.
ARG RUST_IMAGE
FROM ${RUST_IMAGE}

RUN apt-get update \
  && apt-get install --no-install-recommends -y ca-certificates curl qemu-guest-agent qemu-system-x86 \
  && rm -rf /var/lib/apt/lists/*

ARG VMTEST_URL
ARG VMTEST_DOWNLOAD_TIMEOUT_SECONDS=120
RUN curl --fail --location --silent --show-error \
    --max-time "${VMTEST_DOWNLOAD_TIMEOUT_SECONDS}" \
    "${VMTEST_URL}" \
    --output /usr/local/bin/vmtest-upstream \
  && chmod +x /usr/local/bin/vmtest-upstream
